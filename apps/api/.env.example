PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meeti
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# REQUIRED in production: the server refuses to start with the default key.
# Generate: `openssl rand -base64 48`
JWT_SECRET=change-this-to-a-secure-random-string

# At-rest encryption (REQUIRED in production)
# Encrypts stored OAuth access/refresh tokens (AES-256-GCM) so credentials are
# never written to the database in plaintext. The server refuses to start in
# production without it. Generate a fresh 32-byte key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave existing tokens untouched on first enable: legacy plaintext rows keep
# working and are transparently re-encrypted on the next token refresh/reconnect.
# APP_ENCRYPTION_KEY=

# Security / exposure
# Comma-separated list of browser origins allowed to call this API (CORS).
# Native iOS/Android apps send no Origin and are always allowed. If unset, a
# safe default (meeti.org.uk + workers preview + localhost) is used.
# ALLOWED_ORIGINS=https://meeti.org.uk
# General API rate limit per client IP.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# Stricter limit on /auth (login/register/OTP/reset) to stop brute force.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20

# Storage (DISABLED - file upload won't work without credentials)
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=meeti-recordings
# STORAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AI (DISABLED - transcription/AI won't work without API key)
# STT_PROVIDER=openai
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Email delivery (required for sharing notes by email)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Meeting Notes <no-reply@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Feature flags (server-side; default OFF). Set to true to enable.
# FEATURE_RECORDING_CONSENT    - require an in-app consent step before recording/uploading audio
# FEATURE_TOKEN_ROTATION       - issue short access + refreshable/revocable tokens alongside legacy JWT
# FEATURE_CONFIDENCE_HIGHLIGHT - show the estimated transcript-confidence indicator
# FEATURE_RECORDING_CONSENT=false
# FEATURE_TOKEN_ROTATION=false
# FEATURE_CONFIDENCE_HIGHLIGHT=false
